{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vibeclicker",
  "version": "0.1.0",
  "identifier": "dev.vibeclicker.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vibeclicker",
        "width": 700,
        "height": 558,
        "minWidth": 420,
        "minHeight": 558,
        "maxWidth": 700,
        "maxHeight": 558,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "transparent": true,
        "center": true,
        "additionalBrowserArgs": "--disable-gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"]
  }
}
