{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vibeclicker",
  "version": "0.2.0",
  "identifier": "dev.vibeclicker.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vibeclicker",
        "width": 700,
        "height": 558,
        "minWidth": 420,
        "minHeight": 558,
        "maxWidth": 700,
        "maxHeight": 1600,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "transparent": true,
        "center": true,
        "additionalBrowserArgs": "--disable-gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2RTZFQjExOUE4QTQ5NTIKUldSU1NZcWFFZXZtVnFHdTY1LzBGWEdjWmtKemc0T2JxbnVqeUoybGJBNE51U2FhbjlqZlMwakcK",
      "endpoints": [
        "https://github.com/zualo/vibeclicker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
